# NestJS declara peer dependencies opcionales que no necesitamos resolver en todos los paquetes.
strict-peer-dependencies=false

# Un lockfile por repositorio, no por workspace.
shared-workspace-lockfile=true

# Los builds aprobados NO se configuran aquí.
# `onlyBuiltDependencies` fue eliminado en pnpm 11 y se ignora en silencio; su sustituto es el
# mapa `allowBuilds` de pnpm-workspace.yaml, que es el único sitio donde pnpm lo lee.
