// Esquema Prisma para MySQL 8.0+ (Fase 1).
// Ver ADR-026 en docs/decisions.md para la elección de motor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(60)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  users      User[]
  identities Identity[]
  leads      Lead[]
  auditLogs  AuditLog[]
  outboxEvents OutboxEvent[]

  @@map("organizations")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model User {
  id             String     @id @default(uuid()) @db.VarChar(36)
  organizationId String     @map("organization_id") @db.VarChar(36)
  email          String     @unique @db.VarChar(254)
  passwordHash   String     @map("password_hash") @db.Text
  role           UserRole
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?  @map("last_login_at") @db.DateTime(3)
  failedAttempts Int        @default(0) @map("failed_attempts")
  lockedUntil    DateTime?  @map("locked_until") @db.DateTime(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.VarChar(36)
  userId       String    @map("user_id") @db.VarChar(36)
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  familyId     String    @map("family_id") @db.VarChar(36)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById String?   @map("replaced_by_id") @db.VarChar(36)
  userAgent    String?   @map("user_agent") @db.Text
  ip           String?   @map("ip") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Identity {
  id             String   @id @default(uuid()) @db.VarChar(36)
  organizationId String   @map("organization_id") @db.VarChar(36)
  email          String?  @db.VarChar(254)
  phone          String?  @db.VarChar(20)
  firstSeenAt    DateTime @map("first_seen_at") @db.DateTime(3)
  lastSeenAt     DateTime @map("last_seen_at") @db.DateTime(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@index([organizationId, email])
  @@map("identities")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum LeadChannel {
  META_LEAD_FORM
  LANDING_FORM
  WHATSAPP_CLICK
  MESSENGER
  ORGANIC
  MANUAL
}

enum ClosedVia {
  WHATSAPP
  MESSENGER
  INSTAGRAM_DM
  PHONE
  SITE
  PRESENCIAL
}

model Lead {
  id              String      @id @default(uuid()) @db.VarChar(36)
  organizationId  String      @map("organization_id") @db.VarChar(36)
  identityId      String      @map("identity_id") @db.VarChar(36)
  contactName     String?     @map("contact_name") @db.VarChar(200)
  status          LeadStatus  @default(NEW)
  source          String      @db.VarChar(20)
  channel         LeadChannel
  score           Int?        @db.SmallInt
  ownerUserId     String?     @map("owner_user_id") @db.VarChar(36)
  firstResponseAt DateTime?   @map("first_response_at") @db.DateTime(3)
  convertedAt     DateTime?   @map("converted_at") @db.DateTime(3)
  closedVia       ClosedVia?  @map("closed_via")
  consentJson     Json?       @map("consent_json")
  createdAt       DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity     Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([identityId])
  @@map("leads")
}

enum AuditLogAction {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  SETUP_COMPLETED
  PASSWORD_CHANGED
  REFRESH_TOKEN_REVOKED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_CONVERTED
  OTHER

  @@map("audit_log_actions")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.VarChar(36)
  organizationId String?        @map("organization_id") @db.VarChar(36)
  userId         String?        @map("user_id") @db.VarChar(36)
  action         AuditLogAction @map("action")
  resource       String?        @map("resource") @db.VarChar(64)
  resourceId     String?        @map("resource_id") @db.VarChar(36)
  metadata       Json?          @map("metadata") @db.Json
  ip             String?        @map("ip") @db.VarChar(45)
  userAgent      String?        @map("user_agent") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

enum OutboxStatus {
  PENDING
  DELIVERED
  FAILED

  @@map("outbox_statuses")
}

model OutboxEvent {
  id           String       @id @default(uuid()) @db.VarChar(36)
  organizationId String?    @map("organization_id") @db.VarChar(36)
  type         String       @map("type") @db.VarChar(64)
  aggregateId  String?      @map("aggregate_id") @db.VarChar(36)
  payload      Json         @map("payload") @db.Json
  status       OutboxStatus @default(PENDING) @map("status")
  retryCount   Int          @default(0) @map("retry_count")
  errorMessage String?      @map("error_message") @db.Text
  scheduledAt  DateTime     @default(now()) @map("scheduled_at") @db.DateTime(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([type, aggregateId])
  @@index([organizationId, createdAt])
  @@map("outbox_events")
}
