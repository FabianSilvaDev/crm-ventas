# ---------------------------------------------------------------------------
# AI Operations CMS - variables de entorno (valores de demostracion)
# Copia este archivo como .env dentro de backend/ y ajusta si lo necesitas.
# Ninguna de estas variables contiene credenciales reales.
# ---------------------------------------------------------------------------

# Puerto del backend Express
PORT=3000

# Entorno de ejecucion: development | production
NODE_ENV=development

# Origenes permitidos por CORS (separados por coma). El frontend Angular
# de desarrollo vive por defecto en el puerto 4200.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Milisegundos que tarda cada etapa de un flujo simulado en completarse.
SIMULATION_STEP_MS=4200

# Milisegundos que dura el calculo simulado de una tarea de agente.
SIMULATION_TASK_MS=2600

# Probabilidad (0-1) de que una etapa simulada termine en error controlado.
# Solo afecta a las etapas propensas a fallo (ver backend/src/mocks/workflow.js).
# Ponlo a 0 para que la demostracion nunca se detenga por un error simulado.
SIMULATION_FAILURE_RATE=0.03

# Intervalo sugerido de polling (ms) que anuncia la API al frontend.
POLL_INTERVAL_MS=1500

# Puertas de decision dentro del flujo (validacion, presupuesto y publicacion).
# Con `on` el flujo se detiene y espera tu decision; con `off` recorre el ciclo del
# tiron, util para demostraciones desatendidas.
SIMULATION_GATES=on

# ---------------------------------------------------------------------------
# Fuentes de datos del estudio de oportunidad
# ---------------------------------------------------------------------------
# auto      -> usa las fuentes reales disponibles y completa con la demo (marcada)
# live      -> solo fuentes reales; si no hay ninguna, no devuelve datos
# simulated -> no sale a la red; trabaja solo con los datos de demostracion
SOURCES_MODE=auto
SOURCES_TIMEOUT_MS=8000
SOURCES_PAGE_SIZE=20

# Google Trends: no necesita credenciales. Google limita las IP de servidor (429),
# por eso la serie de interes puede fallar desde un VPS.
TRENDS_GEO=ES
TRENDS_TIMEFRAME=today 12-m
TRENDS_HL=es
TRENDS_TZ=-60

# AliExpress: requiere una aplicacion aprobada en su Open Platform
# (https://openservice.aliexpress.com/). Dejalo vacio para trabajar en modo demo.
# ALIEXPRESS_ROLE=buyer significa que compras ahi para revender, asi que el precio
# observado se interpreta como COSTE; con `seller` se interpreta como precio de venta.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_ROLE=buyer

# Alibaba.com: requiere acceso a su Open Platform (https://open.alibaba.com/).
# Confirma el nombre exacto del metodo de busqueda aprobado para tu aplicacion.
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_SEARCH_METHOD=alibaba.icbu.product.search
