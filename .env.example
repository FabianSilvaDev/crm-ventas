# Copia este archivo a `.env` y ajusta los valores. `.env` está en .gitignore:
# nunca debe commitearse.
#
# Validado al arrancar por apps/api/src/config/env.ts. Si un valor no cuadra, la app NO arranca
# y lista todos los errores juntos.

# development | test | production
NODE_ENV=development

PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Origen exacto de apps/web (el CRM interno).
# Debe ser una URL exacta, sin comodines: el refresh token viaja en una cookie `__Host-` y
# `Access-Control-Allow-Credentials` prohíbe `*`.
WEB_ORIGIN=http://localhost:4200

# ─────────────────────────────────────────────────────────────────────────────
# Todavía SIN consumidor: Prisma y BullMQ no están instalados en este hito.
# Se validan ya (y son opcionales) porque un typo en una URL de conexión es el fallo de
# despliegue más común. Pasan a ser OBLIGATORIAS en el Hito 2, cuando la app no pueda
# funcionar sin ellas.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://crm:change-me@localhost:5432/crm
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# Meta Lead Ads (docs/api.md §8, ADR-017). Es la vía de entrada principal de leads.
#
# Los tres primeros son OBLIGATORIOS y no tienen valor por defecto: un secreto por defecto
# es un secreto público. Si falta META_APP_SECRET o META_VERIFY_TOKEN la app NO arranca.
#
# Los valores de este archivo son de ejemplo: NO uses estos en un despliegue real.
# ─────────────────────────────────────────────────────────────────────────────

# App Secret de la app de Meta (Configuración → Básica). Firma y verifica los webhooks.
# Se compara en tiempo constante contra el HMAC del cuerpo crudo.
META_APP_SECRET=00000000000000000000000000000000

# Token que TÚ inventas y pegas también en la configuración del webhook en Meta.
# Meta te lo devuelve en el handshake `GET /webhooks/meta` una sola vez, al verificar la URL.
META_VERIFY_TOKEN=00000000000000000000000000000000

# Token de la Graph API. Solo hace falta si META_GRAPH_MODE=live.
# Permiso necesario: leads_retrieval (requiere app de Meta aprobada y verificación de negocio).
# META_ACCESS_TOKEN=

# live | fixture
#   fixture (por defecto): los datos del lead salen de apps/api/src/webhooks/meta/fixtures/.
#                          Permite desarrollar y probar sin credenciales de Meta.
#   live: llama al Graph API de verdad.
# PROHIBIDO `fixture` con NODE_ENV=production: la app no arranca así.
META_GRAPH_MODE=fixture

# Versión del Graph API. Fijada a propósito, nunca "la última": Meta rompe compatibilidad
# hacia atrás y una versión flotante cambiaría el comportamiento sin que nadie toque nada.
META_GRAPH_API_VERSION=v21.0

# Tiempo máximo de una llamada al Graph API, en milisegundos. Una llamada colgada sin límite
# bloquea la ingesta entera.
META_GRAPH_TIMEOUT_MS=3000

# Límite de peticiones por IP y minuto en los endpoints públicos (los que llama Meta).
# Es un contador en memoria del proceso: con varias réplicas cada una cuenta por su cuenta,
# y por eso el despliegue multi-réplica queda bloqueado hasta que exista el store compartido.
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# ─────────────────────────────────────────────────────────────────────────────
# Todavía SIN consumidor, como DATABASE_URL: se cablean cuando exista la ingesta con base
# de datos (Hito 2). Se declaran aquí porque son valores que hay que DECIDIR, no inventar
# en el código por defecto.
# ─────────────────────────────────────────────────────────────────────────────
# Versión de la política de tratamiento de datos que se graba en cada testimonio de
# consentimiento, para poder acreditar con qué texto aceptó una persona.
# CONSENT_POLICY_VERSION=

# Organización por defecto del MVP (uso interno, despliegue único). Ver ADR-011.
# DEFAULT_ORGANIZATION_ID=

# Ruta de la base de datos JSON. Opcional; por defecto usa apps/api/db.
# DB_PATH=./apps/api/db

# Token estático de desarrollo para autenticar endpoints de negocio antes de JWT.
# Solo se usa fuera de producción. Mínimo 16 caracteres.
# PROHIBIDO en NODE_ENV=production: la app no arranca así.
DEV_API_TOKEN=dev-local-token-no-es-un-secreto-real

# ─────────────────────────────────────────────────────────────────────────────
# Pendientes de definir antes de la Fase 3 (ver docs/decisions.md, ADR-019):
# el modelo de embeddings y su dimensión ya están decididos, pero estas variables se
# cablean cuando entre la primera tarea de IA.
# ─────────────────────────────────────────────────────────────────────────────
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
